{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nudge",
  "version": "0.1.0",
  "identifier": "dev.nudge.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui build"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "overlay",
        "url": "index.html",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false,
        "acceptFirstMouse": true,
        "width": 1512,
        "height": 982,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "panel",
        "url": "index.html",
        "title": "Nudge",
        "width": 560,
        "height": 420,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": true,
        "shadow": false,
        "focus": false
      },
      {
        "label": "agents",
        "url": "index.html",
        "title": "Nudge agents",
        "width": 360,
        "height": 220,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "shadow": false
      },
      {
        "label": "connect",
        "url": "index.html",
        "title": "Nudge agents",
        "width": 760,
        "height": 180,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwMDc5MDgxNjc4ODQyQ0UKUldUT1FvaG5nWkFIZ0VqTHZ3bVRxcnE3TTB5TGhMek5ReDNNd0tDZ3BrUTYvR1F4eEIvcUp1NTcK",
      "endpoints": [
        "https://nudge.runmycrew.com/api/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
